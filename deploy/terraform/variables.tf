variable "project_id" {
  description = "Target GCP project ID where the Quota Governor infrastructure is deployed."
  type        = string
}

variable "region" {
  description = "Primary GCP region for the Internal Application Load Balancer and workloads."
  type        = string
}

variable "network_name" {
  description = "Existing VPC network name attached to the Private DNS zone and Internal ALB."
  type        = string
  default     = "default"
}

variable "subnetwork_name" {
  description = "Existing VPC subnetwork name for the Internal ALB forwarding rule."
  type        = string
  default     = "default"
}

variable "proxy_only_subnetwork_name" {
  description = "Name of the Regional Managed Proxy subnetwork (REGIONAL_MANAGED_PROXY) required by the Internal ALB."
  type        = string
}

variable "controlplane_image" {
  description = "Container image URI for cmd/controlplane."
  type        = string
}

variable "dataplane_image" {
  description = "Container image URI for cmd/dataplane (Envoy ext_proc server)."
  type        = string
}

variable "tls_certificate_pem_path" {
  description = "Path to the PEM-encoded leaf certificate for *.aiplatform.googleapis.com (generated by scripts/setup_local_ca.sh)."
  type        = string
}

variable "tls_private_key_pem_path" {
  description = "Path to the PEM-encoded private key for *.aiplatform.googleapis.com."
  type        = string
}

variable "enable_gke_autopilot" {
  description = "Whether to provision a dedicated GKE Autopilot cluster in addition to the Cloud Run services."
  type        = bool
  default     = false
}

variable "enable_service_extensions" {
  description = "Whether to attach a Cloud Load Balancing Service Extension (LbTrafficExtension) callout to the Internal ALB."
  type        = bool
  default     = true
}
